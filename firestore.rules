rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'karishamanishad2@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() &&
             (isBootstrappedAdmin() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Entity Validation: Booking
    function isValidBooking(data) {
      return data.customerName is string &&
             data.customerName.size() >= 2 &&
             data.customerName.size() <= 80 &&
             data.phone is string &&
             data.phone.size() >= 10 &&
             data.phone.size() <= 15 &&
             data.phone.matches('^[0-9+ ]+$') &&
             data.serviceType in ['ac', 'ro', 'cooler', 'freezer', 'washing_machine', 'other'] &&
             data.serviceArea is string &&
             data.serviceArea.size() <= 80 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('preferredDate' in data) || (data.preferredDate is string && data.preferredDate.size() <= 30)) &&
             (!('preferredTimeSlot' in data) || (data.preferredTimeSlot is string && data.preferredTimeSlot.size() <= 30)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('serviceTitle' in data) || (data.serviceTitle is string && data.serviceTitle.size() <= 100)) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             data.status in ['pending', 'confirmed', 'in_progress', 'completed', 'cancelled'] &&
             data.createdAt is timestamp;
    }

    // Entity Validation: Technician Application
    function isValidTechnicianApplication(data) {
      return data.fullName is string &&
             data.fullName.size() >= 2 &&
             data.fullName.size() <= 80 &&
             data.phone is string &&
             data.phone.size() >= 10 &&
             data.phone.size() <= 15 &&
             data.phone.matches('^[0-9+ ]+$') &&
             (!('experienceYears' in data) || (data.experienceYears is string && data.experienceYears.size() <= 30)) &&
             (!('skills' in data) || (data.skills is string && data.skills.size() <= 200)) &&
             (!('preferredArea' in data) || (data.preferredArea is string && data.preferredArea.size() <= 80)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 500)) &&
             data.status in ['new', 'reviewed', 'contacted', 'rejected'] &&
             data.createdAt is timestamp;
    }

    // Entity Validation: Review
    function isValidReview(data) {
      return data.authorName is string &&
             data.authorName.size() >= 2 &&
             data.authorName.size() <= 80 &&
             data.rating is number &&
             data.rating >= 1 &&
             data.rating <= 5 &&
             data.comment is string &&
             data.comment.size() <= 500 &&
             data.isApproved is bool &&
             (!('serviceCategory' in data) || (data.serviceCategory is string && data.serviceCategory.size() <= 80)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 80)) &&
             data.createdAt is timestamp;
    }

    // Entity Validation: Admin
    function isValidAdmin(data) {
      return data.email is string &&
             data.email.size() <= 120 &&
             data.role == 'admin';
    }

    // -------------------------------------------------------------
    // Bookings Collection
    // -------------------------------------------------------------
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );

      allow list: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );

      // Anyone (customer or guest) can create a booking with status 'pending'
      allow create: if isValidId(bookingId) &&
                       isValidBooking(incoming()) &&
                       incoming().status == 'pending' &&
                       incoming().createdAt == request.time &&
                       (!('userId' in incoming()) || !isSignedIn() || incoming().userId == request.auth.uid);

      // Only admins or the booking owner can update (owner can only cancel)
      allow update: if isValidId(bookingId) &&
                       isValidBooking(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isAdmin() ||
                         (
                           isSignedIn() &&
                           existing().userId == request.auth.uid &&
                           incoming().userId == existing().userId &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                           incoming().status == 'cancelled'
                         )
                       );

      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // -------------------------------------------------------------
    // Technician Applications Collection
    // -------------------------------------------------------------
    match /technician_applications/{applicationId} {
      allow get, list: if isAdmin();

      // Any technician can submit an application
      allow create: if isValidId(applicationId) &&
                       isValidTechnicianApplication(incoming()) &&
                       incoming().status == 'new' &&
                       incoming().createdAt == request.time;

      allow update: if isValidId(applicationId) &&
                       isAdmin() &&
                       isValidTechnicianApplication(incoming()) &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // -------------------------------------------------------------
    // Reviews Collection
    // -------------------------------------------------------------
    match /reviews/{reviewId} {
      // Approved reviews are public, or admins can view all
      allow get: if isValidId(reviewId) && (resource.data.isApproved == true || isAdmin());
      allow list: if resource.data.isApproved == true || isAdmin();

      // Customers can submit reviews (unapproved by default, or admin can add approved)
      allow create: if isValidId(reviewId) &&
                       isValidReview(incoming()) &&
                       incoming().createdAt == request.time &&
                       (incoming().isApproved == false || isAdmin());

      allow update: if isValidId(reviewId) &&
                       isAdmin() &&
                       isValidReview(incoming()) &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(reviewId) && isAdmin();
    }

    // -------------------------------------------------------------
    // Admins Collection
    // -------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isSignedIn() && request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) &&
                       isValidAdmin(incoming()) &&
                       (isBootstrappedAdmin() || isAdmin());
      allow update: if isValidId(adminId) &&
                       isAdmin() &&
                       isValidAdmin(incoming());
      allow delete: if isValidId(adminId) && isAdmin() && adminId != request.auth.uid;
    }

  }
}
